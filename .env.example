# Point these at the SAME Firebase project and JWT secret as the main
# Optinex app — this admin tool reads/writes the same Firestore data and
# needs to verify the same session cookies.

# Firebase Admin SDK (server-side)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase client SDK (used for Firebase Auth only — Firestore always goes
# through our own API routes, never directly from the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Must be the exact same secret the main app uses to sign access tokens —
# otherwise sessions won't verify across the two apps.
JWT_ACCESS_SECRET=
